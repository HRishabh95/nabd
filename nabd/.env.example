# Copy to nabd/.env. Never commit real keys or contacts.
NABD_LLM_PROVIDER=codex          # codex (demo: prompts go to OpenAI) | azure_openai (UAE North) | local (on premise)
# NABD_CODEX_MODEL=              # unset = the signed-in account's default model
# NABD_CODEX_HOME=               # unset = ~/.codex
# NABD_DATA_DIR=                 # unset = nabd/data
# NABD_SEC_USER_AGENT=           # "Your Org Nabd POC you@your-org.com" turns on SEC EDGAR (SEC requires a contact)
# NABD_FRED_API_KEY=             # optional; the public FRED CSV is used without it
# NABD_REFRESH_ENABLED=true      # scheduled refreshes, model reruns and monitoring
